<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ─────────────────────────────────────────────────────────────
         FORMULAIRE PRINCIPAL DU BAIL
    ───────────────────────────────────────────────────────────────── -->
    <record id="view_re_lease_form" model="ir.ui.view">
        <field name="name">re.lease.form</field>
        <field name="model">re.lease</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirmer" type="object" class="oe_highlight" invisible="lease_state != '1_draft'"/>
                    <button name="action_reset_to_draft" string="Remettre en brouillon" type="object" class="btn-secondary" invisible="lease_state == '1_draft'"/>
                    <button name="action_print_contract" string="🖨️ Imprimer contrat" type="object" class="btn-primary" invisible="not contract_template_id"/>
                    <button name="action_generate_entry_invoice" string="💵 Générer reçu d'entrée" type="object" class="oe_highlight btn-info" invisible="lease_state != '1_draft' or invoice_count &gt; 0"/>
                    <button name="action_create_invoice_manual" string="💳 Générer le reçu" type="object" class="oe_highlight btn-success" invisible="lease_state != '3_progress'" help="Génère un reçu de loyer pour la prochaine période. La date est avancée automatiquement."/>
                    
                    <button name="action_compute_penalties" string="Calculer pénalités" type="object" icon="fa-exclamation-triangle" invisible="lease_state != '3_progress'"/>
                    <button name="action_close_lease" string="Résilier / Clôturer" type="object" invisible="lease_state not in ('3_progress','4_paused')"/>
                    <button name="action_create_amendment" string="Avenant" type="object" invisible="lease_state != '3_progress'"/>
                    <button name="action_renew_lease" string="Renouveler" type="object" invisible="lease_state not in ('3_progress', '4_paused')"/>
                    <button name="action_pause" string="Suspendre" type="object" invisible="lease_state != '3_progress'"/>
                    <button name="action_resume" string="Reprendre" type="object" invisible="lease_state != '4_paused'"/>
                    
                    <field name="lease_state" widget="statusbar" statusbar_visible="1_draft,3_progress,6_churn"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_penalties" type="object" class="oe_stat_button" icon="fa-warning" invisible="penalty_count == 0">
                            <field name="penalty_count" widget="statinfo" string="Pénalités"/>
                        </button>
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="invoice_count == 0">
                            <field name="invoice_count" widget="statinfo" string="Reçus"/>
                        </button>
                        <button name="action_view_collected_taxes" type="object" class="oe_stat_button" icon="fa-money" invisible="total_tax_collected == 0">
                            <field name="total_tax_collected" widget="statinfo" string="Taxes coll."/>
                        </button>
                        <button name="action_view_collected_savings" type="object" class="oe_stat_button" icon="fa-bank" invisible="total_saving_collected == 0">
                            <field name="total_saving_collected" widget="statinfo" string="Épargne coll."/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <field name="is_locked" invisible="1"/>
                    <field name="currency_id" invisible="1"/>

                    <notebook>
                        <!-- 1. ONGLET BAIL -->
                        <page string="📄 Bail" name="lease_tab">
                            <group>
                                <group string="Informations contrat">
                                    <field name="property_id" readonly="lease_state != '1_draft'"/>
                                    <field name="lease_type" readonly="lease_state != '1_draft'"/>
                                    <field name="plan_id" readonly="lease_state != '1_draft'"/>
                                    <field name="contract_template_id" options="{'no_create': True}" readonly="lease_state != '1_draft'"/>
                                </group>
                                <group string="Dates de validité">
                                    <field name="start_date" readonly="lease_state != '1_draft'"/>
                                    <field name="end_date" readonly="lease_state != '1_draft'"/>
                                    <field name="first_due_date" readonly="1"/>
                                    <field name="next_invoice_date" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- 2. ONGLET LOCATAIRE -->
                        <page string="👤 Locataire" name="tenant_tab">
                            <group>
                                <group string="Coordonnées">
                                    <field name="tenant_id" string="Locataire principal" options="{'no_create': True}"/>
                                    <field name="tenant_ref_snapshot" string="Réf. locataire" readonly="1"/>
                                    <field name="tenant_phone" string="Téléphone"/>
                                    <field name="tenant_email" string="Email"/>
                                </group>
                                <group string="Garant &amp; Co-locataires">
                                    <field name="guarantor_id" string="Garant" options="{'no_create': True}"/>
                                    <field name="guarantor_phone" string="Téléphone garant"/>
                                    <field name="guarantor_email" string="Email garant"/>
                                    <field name="co_tenant_ids" widget="many2many_tags" placeholder="Co-locataires..." options="{'no_create': True}"/>
                                </group>
                            </group>
                            <group string="Pièce d'identité">
                                <group>
                                    <field name="tenant_id_type"/>
                                    <field name="tenant_id_number"/>
                                    <field name="tenant_id_expiry"/>
                                </group>
                                <group>
                                    <field name="tenant_id_scan" filename="tenant_id_scan_filename"/>
                                    <field name="tenant_id_scan_filename" invisible="1"/>
                                    <field name="tenant_id_scan_back" filename="tenant_id_scan_back_filename"/>
                                    <field name="tenant_id_scan_back_filename" invisible="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- 3. ONGLET RÉSUMÉ FINANCIER -->
                        <page string="💰 Résumé financier" name="financial_tab">
                            <group string="Grille Loyer &amp; Caution">
                                <group>
                                    <field name="rent_amount" readonly="lease_state != '1_draft'"/>
                                    <field name="advance_months" readonly="lease_state != '1_draft'"/>
                                    <field name="advance_amount" readonly="1"/>
                                </group>
                                <group>
                                    <field name="deposit_amount" readonly="lease_state != '1_draft'"/>
                                    <field name="signature_total" string="Total à l'entrée" readonly="1"/>
                                </group>
                            </group>
                            <group string="Statut Financier">
                                <group>
                                    <label for="deposit_paid"/>
                                    <div class="o_row">
                                        <field name="deposit_paid" readonly="1"/>
                                        <span class="badge text-bg-success" invisible="not deposit_paid">Déjà payée</span>
                                        <button name="action_force_deposit_paid" string="Forcer caution payée" type="object" class="btn btn-warning py-0" invisible="deposit_paid or lease_state != '1_draft'"/>
                                    </div>
                                    <field name="deposit_paid_date" readonly="1" invisible="not deposit_paid"/>
                                    <field name="deposit_returned"/>
                                    <field name="deposit_return_date" invisible="not deposit_returned"/>
                                </group>
                                <group>
                                    <label for="entry_invoice_paid"/>
                                    <div class="o_row">
                                        <field name="entry_invoice_paid" readonly="1"/>
                                        <span class="badge text-bg-success" invisible="not entry_invoice_paid">Déjà payée</span>
                                        <button name="action_force_entry_invoice_paid" string="Forcer avance payée" type="object" class="btn btn-warning py-0" invisible="entry_invoice_paid or lease_state != '1_draft'"/>
                                    </div>
                                </group>
                            </group>
                            <group string="Taxes Applicables">
                                <field name="tax_line_ids" nolabel="1" readonly="is_locked">
                                    <list editable="bottom">
                                        <field name="tax_id" domain="[('is_real_estate_tax', '=', True)]"/>
                                        <field name="tax_bearer"/>
                                        <field name="tenant_share_percent"/>
                                        <field name="is_active"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <!-- 4. ONGLET ÉCHÉANCES -->
                        <page string="📅 Échéances" name="invoices_tab">
                            <group string="Historique des échéances (Reçus de loyer)">
                                <field name="invoice_ids" nolabel="1" readonly="1">
                                    <list create="0" delete="0">
                                        <field name="invoice_date_due" string="Échéance"/>
                                        <field name="name" string="Référence"/>
                                        <field name="invoice_period_start" string="Début"/>
                                        <field name="invoice_period_end" string="Fin"/>
                                        <field name="amount_total" string="Montant"/>
                                        <field name="payment_state" widget="badge"
                                               decoration-success="payment_state in ('paid', 'in_payment')"
                                               decoration-warning="payment_state == 'partial'"
                                               decoration-danger="payment_state == 'not_paid'"/>
                                        <button name="action_print_payment_receipt" string="🖨️ Reçu" type="object"
                                                icon="fa-print" title="Télécharger le reçu de paiement"
                                                invisible="payment_state not in ('paid', 'in_payment')"/>
                                        <button name="action_post" string="Valider" type="object"
                                                icon="fa-check" title="Valider ce reçu"
                                                invisible="state != 'draft'"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Pénalités générées">
                                <field name="penalty_ids" nolabel="1" readonly="1">
                                    <list>
                                        <field name="name" string="Référence"/>
                                        <field name="invoice_id" string="Reçu"/>
                                        <field name="days_late" string="Retard (jours)"/>
                                        <field name="penalty_amount" string="Montant"/>
                                        <field name="state" widget="badge"
                                               decoration-warning="state == 'draft'"
                                               decoration-success="state == 'invoiced'"
                                               decoration-danger="state == 'cancelled'"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <!-- 5. ONGLET ÉPARGNES -->
                        <page string="🏦 Épargnes" name="savings_tab">
                            <group string="Règles d'épargne actives">
                                <field name="saving_rule_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="name" string="Motif"/>
                                        <field name="mode"/>
                                        <field name="value" string="Valeur"/>
                                        <field name="base"/>
                                        <field name="target_account_id" string="Compte cible"
                                               options="{'no_create': True}"
                                               domain="[('account_type', 'not in', ['asset_cash','liability_payable'])]"/>
                                        <field name="is_active"/>
                                    </list>
                                </field>
                            </group>
                            <group>
                                <group>
                                    <field name="total_saving_collected" string="Épargne cumulée collectée" readonly="1"/>
                                </group>
                            </group>
                        </page>

                        <!-- 6. ONGLET DOCUMENTS -->
                        <page string="📁 Documents" name="documents_tab">
                            <group string="Signatures électroniques">
                                <group>
                                    <field name="signature_tenant" widget="signature"/>
                                    <field name="signature_tenant_date"/>
                                    <field name="signature_tenant_name"/>
                                </group>
                                <group>
                                    <field name="signature_owner" widget="signature"/>
                                    <field name="signature_owner_date"/>
                                    <field name="signature_owner_name"/>
                                </group>
                            </group>
                            <group string="Pièces jointes &amp; Contrat">
                                <field name="is_fully_signed" readonly="1"/>
                                <field name="contract_pdf_id" string="Contrat PDF signé"/>
                            </group>
                            <group string="État des lieux">
                                <group string="Entrée dans les lieux">
                                    <field name="checkin_done"/>
                                    <field name="checkin_date"/>
                                    <field name="checkin_note" widget="html"/>
                                    <field name="checkin_image_ids" widget="many2many_binary"/>
                                </group>
                                <group string="Sortie des lieux">
                                    <field name="checkout_done"/>
                                    <field name="checkout_date"/>
                                    <field name="checkout_note" widget="html"/>
                                    <field name="deposit_deductions"/>
                                    <field name="deposit_deduction_note"/>
                                    <field name="checkout_image_ids" widget="many2many_binary"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ─────────────────────────────────────────────────────────────
         VUE LISTE DES BAUX
    ───────────────────────────────────────────────────────────────── -->
    <record id="view_re_lease_tree" model="ir.ui.view">
        <field name="name">re.lease.tree</field>
        <field name="model">re.lease</field>
        <field name="arch" type="xml">
            <list decoration-info="lease_state=='1_draft'" decoration-success="lease_state=='3_progress' and not is_overdue" decoration-danger="is_overdue">
                <field name="name"/>
                <field name="property_id"/>
                <field name="tenant_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="rent_amount"/>
                <field name="deposit_amount" string="Caution"/>
                <field name="lmr" string="LMR"/>
                <field name="is_overdue" column_invisible="True"/>
                <field name="lease_state" widget="badge"
                       decoration-success="lease_state=='3_progress'"
                       decoration-warning="lease_state=='4_paused'"
                       decoration-info="lease_state=='1_draft'"/>
            </list>
        </field>
    </record>

    <!-- ─────────────────────────────────────────────────────────────
         ACTIONS
    ───────────────────────────────────────────────────────────────── -->
    <record id="action_re_lease_all" model="ir.actions.act_window">
        <field name="name">Tous les baux</field>
        <field name="res_model">re.lease</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_re_lease_active" model="ir.actions.act_window">
        <field name="name">Baux Actifs</field>
        <field name="res_model">re.lease</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('lease_state', '=', '3_progress')]</field>
    </record>

    <record id="action_re_building" model="ir.actions.act_window">
        <field name="name">Immeubles</field>
        <field name="res_model">re.building</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Actions finances (quittances + paiements) -->
    <record id="action_re_lease_invoices" model="ir.actions.act_window">
        <field name="name">Reçus de loyer</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'search_default_posted': 1}</field>
    </record>

    <record id="action_re_lease_payments" model="ir.actions.act_window">
        <field name="name">Reçus de paiement</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('payment_type', '=', 'inbound')]</field>
        <field name="context">{'default_payment_type': 'inbound'}</field>
    </record>

    <!-- Action Locataires -->
    <record id="action_re_tenants" model="ir.actions.act_window">
        <field name="name">Locataires</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_tenant', '=', True)]</field>
        <field name="context">{'default_is_tenant': True, 'default_re_contact_type': 'tenant'}</field>
    </record>

    <!-- Action Propriétaires -->
    <record id="action_re_owners" model="ir.actions.act_window">
        <field name="name">Propriétaires</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_property_owner', '=', True)]</field>
        <field name="context">{'default_is_property_owner': True, 'default_re_contact_type': 'owner'}</field>
    </record>

    <!-- Action serveur pour réinitialiser les données de test -->
    <record id="action_server_reset_demo_data" model="ir.actions.server">
        <field name="name">Réinitialiser les données de test</field>
        <field name="model_id" ref="maono_real_estate.model_re_lease"/>
        <field name="state">code</field>
        <field name="code">
            action = env['re.lease'].action_reset_demo_data()
        </field>
        <field name="binding_model_id" ref="maono_real_estate.model_re_lease"/>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>
