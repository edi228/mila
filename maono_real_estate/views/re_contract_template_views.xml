<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_re_contract_template_tree" model="ir.ui.view">
        <field name="name">re.contract.template.tree</field>
        <field name="model">re.contract.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_re_contract_template_form" model="ir.ui.view">
        <field name="name">re.contract.template.form</field>
        <field name="model">re.contract.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_render" string="🔍 Tester le rendu" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nom du modèle de contrat…"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="lease_type"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contenu du contrat">
                            <field name="body_html" widget="html" options="{'safe': True}"/>
                        </page>
                        <page string="Notes internes">
                            <field name="note" placeholder="Notes ou remarques sur l'usage de ce modèle..."/>
                        </page>
                        <page string="Aide aux Placeholders">
                            <div class="alert alert-info" role="alert">
                                <strong>Placeholders disponibles :</strong>
                                <ul>
                                    <li><code>${tenant_name}</code> : Nom complet du locataire</li>
                                    <li><code>${tenant_address}</code> : Adresse du locataire</li>
                                    <li><code>${tenant_id_type}</code> : Type de pièce d'identité</li>
                                    <li><code>${tenant_id_number}</code> : Numéro de pièce</li>
                                    <li><code>${owner_name}</code> : Nom du propriétaire</li>
                                    <li><code>${owner_address}</code> : Adresse du propriétaire</li>
                                    <li><code>${property_name}</code> : Nom du bien</li>
                                    <li><code>${property_address}</code> : Adresse du bien</li>
                                    <li><code>${property_type}</code> : Type du bien</li>
                                    <li><code>${property_surface}</code> : Surface du bien</li>
                                    <li><code>${lease_ref}</code> : Référence du bail</li>
                                    <li><code>${lease_type_label}</code> : Type de bail (ex: Mensuel, Commercial)</li>
                                    <li><code>${start_date}</code> : Date de début du bail</li>
                                    <li><code>${end_date}</code> : Date de fin du bail</li>
                                    <li><code>${rent_amount}</code> : Loyer mensuel en chiffres</li>
                                    <li><code>${rent_amount_words}</code> : Loyer mensuel en lettres</li>
                                    <li><code>${deposit_amount}</code> : Caution en chiffres</li>
                                    <li><code>${deposit_amount_words}</code> : Caution en lettres</li>
                                    <li><code>${advance_months}</code> : Nombre de mois d'avance</li>
                                    <li><code>${advance_amount}</code> : Montant total de l'avance</li>
                                    <li><code>${first_due_date}</code> : Première échéance de loyer</li>
                                    <li><code>${plan_label}</code> : Libellé du plan de facturation</li>
                                    <li><code>${services_list}</code> : Liste des services inclus (HTML)</li>
                                    <li><code>${taxes_list}</code> : Liste des taxes applicables (HTML)</li>
                                    <li><code>${penalty_clause}</code> : Clause de pénalités de retard</li>
                                    <li><code>${today_date}</code> : Date du jour</li>
                                    <li><code>${city}</code> : Ville de l'immeuble</li>
                                </ul>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_re_contract_test_render_wizard_form" model="ir.ui.view">
        <field name="name">re.contract.test.render.wizard.form</field>
        <field name="model">re.contract.test.render.wizard</field>
        <field name="arch" type="xml">
            <form string="Prévisualisation du Contrat">
                <sheet>
                    <field name="html_content" widget="html" options="{'safe': True}"/>
                </sheet>
                <footer>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_re_contract_template" model="ir.actions.act_window">
        <field name="name">Modèles de contrats</field>
        <field name="res_model">re.contract.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
