<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="contract_template_togo_residential_standard" model="re.contract.template">
            <field name="name">Contrat de bail résidentiel standard — MEA &amp; FILS</field>
            <field name="lease_type">monthly</field>
            <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; font-size: 11pt; color: #1a1a1a; padding: 20px;">

  <!-- EN-TÊTE -->
  <div style="text-align:center; border-bottom: 3px solid #0f2a4a; padding-bottom: 16px; margin-bottom: 24px;">
    <div style="font-size:20pt; font-weight:900; color:#0f2a4a; letter-spacing:4px;">MEA &amp; FILS</div>
    <div style="font-size:10pt; color:#888; margin-top:4px;">Gestion Immobilière — Lomé, Togo</div>
    <div style="font-size:16pt; font-weight:700; color:#c5a059; margin-top:12px; text-transform:uppercase;">
      Contrat de Bail ${lease_type_label}
    </div>
    <div style="font-size:10pt; color:#555; margin-top:4px;">Référence : ${lease_ref} — Fait à ${city}, le ${today_date}</div>
  </div>

  <!-- PARTIES -->
  <div style="margin-bottom:20px;">
    <div style="font-size:12pt; font-weight:700; color:#0f2a4a; border-left:4px solid #c5a059; padding-left:10px; margin-bottom:10px;">
      ENTRE LES SOUSSIGNÉS
    </div>
    <p><strong>LE BAILLEUR :</strong><br/>
    ${owner_name}<br/>
    Adresse : ${owner_address}<br/>
    Ci-après dénommé <em>"le Bailleur"</em></p>
    <br/>
    <p><strong>LE PRENEUR :</strong><br/>
    ${tenant_name}<br/>
    Adresse : ${tenant_address}<br/>
    Pièce d'identité : ${tenant_id_type} N° ${tenant_id_number}<br/>
    Ci-après dénommé <em>"le Locataire"</em></p>
  </div>

  <!-- BIEN LOUÉ -->
  <div style="margin-bottom:20px;">
    <div style="font-size:12pt; font-weight:700; color:#0f2a4a; border-left:4px solid #c5a059; padding-left:10px; margin-bottom:10px;">
      ARTICLE 1 — DÉSIGNATION DU BIEN
    </div>
    <p>Le Bailleur donne en location au Locataire le bien désigné ci-après :</p>
    <ul style="margin-top:8px;">
      <li><strong>Bien :</strong> ${property_name}</li>
      <li><strong>Type :</strong> ${property_type}</li>
      <li><strong>Adresse :</strong> ${property_address}</li>
      <li><strong>Surface :</strong> ${property_surface} m²</li>
    </ul>
  </div>

  <!-- DURÉE -->
  <div style="margin-bottom:20px;">
    <div style="font-size:12pt; font-weight:700; color:#0f2a4a; border-left:4px solid #c5a059; padding-left:10px; margin-bottom:10px;">
      ARTICLE 2 — DURÉE DU BAIL
    </div>
    <p>Le présent bail prend effet le <strong>${start_date}</strong> et se termine le <strong>${end_date}</strong>.</p>
    <p>La périodicité de facturation est : <strong>${plan_label}</strong>.</p>
    <p>La première échéance de loyer est fixée au <strong>${first_due_date}</strong>.</p>
  </div>

  <!-- CONDITIONS FINANCIÈRES -->
  <div style="margin-bottom:20px;">
    <div style="font-size:12pt; font-weight:700; color:#0f2a4a; border-left:4px solid #c5a059; padding-left:10px; margin-bottom:10px;">
      ARTICLE 3 — LOYER &amp; CONDITIONS FINANCIÈRES
    </div>
    <table style="width:100%; border-collapse:collapse; margin-top:8px;">
      <tr style="background:#0f2a4a; color:white;">
        <th style="padding:8px 12px; text-align:left;">Élément</th>
        <th style="padding:8px 12px; text-align:right;">Montant</th>
      </tr>
      <tr style="background:#f8f8f8;">
        <td style="padding:7px 12px;">Loyer ${plan_label}</td>
        <td style="padding:7px 12px; text-align:right; font-weight:700;">${rent_amount} FCFA</td>
      </tr>
      <tr>
        <td style="padding:7px 12px; font-style:italic; color:#555;">En lettres</td>
        <td style="padding:7px 12px; text-align:right; font-style:italic; color:#555;">${rent_amount_words}</td>
      </tr>
      <tr style="background:#f8f8f8;">
        <td style="padding:7px 12px;">Caution (${advance_months} mois)</td>
        <td style="padding:7px 12px; text-align:right; font-weight:700;">${deposit_amount} FCFA</td>
      </tr>
      <tr>
        <td style="padding:7px 12px; font-style:italic; color:#555;">En lettres</td>
        <td style="padding:7px 12px; text-align:right; font-style:italic; color:#555;">${deposit_amount_words}</td>
      </tr>
      <tr style="background:#fff8e8; font-weight:700; color:#0f2a4a;">
        <td style="padding:8px 12px; border-top:2px solid #c5a059;">Total encaissé à l'entrée</td>
        <td style="padding:8px 12px; text-align:right; border-top:2px solid #c5a059;">${advance_amount} FCFA</td>
      </tr>
    </table>
  </div>

  <!-- SERVICES INCLUS -->
  <div style="margin-bottom:20px;">
    <div style="font-size:12pt; font-weight:700; color:#0f2a4a; border-left:4px solid #c5a059; padding-left:10px; margin-bottom:10px;">
      ARTICLE 4 — SERVICES INCLUS
    </div>
    <p>${services_list}</p>
  </div>

  <!-- TAXES -->
  <div style="margin-bottom:20px;">
    <div style="font-size:12pt; font-weight:700; color:#0f2a4a; border-left:4px solid #c5a059; padding-left:10px; margin-bottom:10px;">
      ARTICLE 5 — TAXES APPLICABLES
    </div>
    <p>${taxes_list}</p>
  </div>

  <!-- PÉNALITÉS -->
  <div style="margin-bottom:20px;">
    <div style="font-size:12pt; font-weight:700; color:#0f2a4a; border-left:4px solid #c5a059; padding-left:10px; margin-bottom:10px;">
      ARTICLE 6 — PÉNALITÉS DE RETARD
    </div>
    <p>${penalty_clause}</p>
  </div>

  <!-- SIGNATURES -->
  <div style="margin-top:48px;">
    <div style="font-size:12pt; font-weight:700; color:#0f2a4a; border-left:4px solid #c5a059; padding-left:10px; margin-bottom:20px;">
      SIGNATURES DES PARTIES
    </div>
    <table style="width:100%;">
      <tr>
        <td style="width:50%; vertical-align:top; padding-right:20px;">
          <div style="border:1px solid #CBD5E1; border-radius:6px; padding:16px; min-height:120px;">
            <div style="font-weight:700; color:#0f2a4a; margin-bottom:8px;">LE BAILLEUR</div>
            <div style="color:#555; font-size:9.5pt;">${owner_name}</div>
            <div style="margin-top:40px; border-top:1px solid #CBD5E1; padding-top:8px; color:#888; font-size:8.5pt;">
              Signature &amp; cachet — Date : ____________
            </div>
          </div>
        </td>
        <td style="width:50%; vertical-align:top; padding-left:20px;">
          <div style="border:1px solid #CBD5E1; border-radius:6px; padding:16px; min-height:120px;">
            <div style="font-weight:700; color:#0f2a4a; margin-bottom:8px;">LE LOCATAIRE</div>
            <div style="color:#555; font-size:9.5pt;">${tenant_name}</div>
            <div style="margin-top:40px; border-top:1px solid #CBD5E1; padding-top:8px; color:#888; font-size:8.5pt;">
              Signature — Lu et approuvé — Date : ____________
            </div>
          </div>
        </td>
      </tr>
    </table>
  </div>

  <!-- PIED DE PAGE -->
  <div style="margin-top:32px; border-top:1px solid #e5e7eb; padding-top:10px; text-align:center; color:#9CA3AF; font-size:8pt;">
    ${lease_ref} — MEA &amp; FILS Gestion Immobilière — ${city} — Document généré le ${today_date}
  </div>

</div>
            ]]></field>
        </record>
    </data>
</odoo>
